# Local developer environment for Shelfcheck.
# Copy to .env, replace placeholders, then keep .env owner-readable only.
# Load it before running Shelfcheck: set -a && . ./.env && set +a

# Optional human-readable label. Shelfcheck derives identity from the token.
HARDCOVER_USERNAME=your-hardcover-username

# Required for Hardcover account features.
HARDCOVER_TOKEN=your-hardcover-api-token

# Optional: required only for BiblioCommons account commands.
# SHELFCHECK_CARD=your-library-card-number
# SHELFCHECK_PIN=your-library-pin
